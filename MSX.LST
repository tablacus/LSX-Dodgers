000FC1 D55E 21C1FC          10      LD  HL,EXPTBL
000FC4 D561 2014            12      JR  NZ,GETSLT_C0H
       D563                     GETSLT_80H:             ;ページ2
000FC6 D563 0F               4      RRCA
000FC7 D564 0F               4      RRCA
000FC8 D565 0F               4      RRCA
000FC9 D566 0F               4      RRCA
000FCA D567 E603             7      AND 3
000FCC D569 85               4      ADD A,L
000FCD D56A 6F               4      LD  L,A
000FCE D56B CB7E            13      BIT 7,(HL)
000FD0 D56D 28D9            12      JR  Z,GETSLT_1
000FD2 D56F C604             7      ADD A,SLTTBL-EXPTBL
000FD4 D571 6F               4      LD  L,A
000FD5 D572 7E               7      LD  A,(HL)
000FD6 D573 0F               4      RRCA
000FD7 D574 0F               4      RRCA
