000FE6 D583 6F               4      LD  L,A
000FE7 D584 7E               7      LD  A,(HL)
000FE8 D585 07               4      RLCA
000FE9 D586 07               4      RLCA
000FEA D587 18B4            12      JR  GETSLT_3
                                
       D589                     SAME_SLOT_00H:          ;ページ0とページ3のスロットが同一
000FEC D589 D3A8            11      OUT (0A8H),A
