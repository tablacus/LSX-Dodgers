       4F86                     AT_GETSLT   EQU 04000H+$$
                                
                                ;
                                ;   現在のスロットを知る
                                ;in
                                ;HL←上位2ビットで切り替えるページを指定
                                ;out
                                ;A→スロット
                                ;※ROM、RAMの両方のルーチンを使うため絶対番地を使わない
       D523                     _GETSLT:
000F86 D523 E5              11      PUSH    HL
000F87 D524 DBA8            11      IN  A,(0A8H)
                                
000F89 D526 CB7C             8      BIT 7,H
000F8B D528 2032            12      JR  NZ,GETSLT_HIGH
000F8D D52A CB74             8      BIT 6,H
000F8F D52C 21C1FC          10      LD  HL,EXPTBL
000F92 D52F 201B            12      JR  NZ,GETSLT_40H
       D531                     GETSLT_00H:             ;ページ0
000F94 D531 E603             7      AND 3
000F96 D533 85               4      ADD A,L
000F97 D534 6F               4      LD  L,A
000F98 D535 CB7E            13      BIT 7,(HL)
000F9A D537 280F            12      JR  Z,GETSLT_1
000F9C D539 C604             7      ADD A,SLTTBL-EXPTBL     ;拡張スロットをワークアリアから取得
000F9E D53B 6F               4      LD  L,A
000F9F D53C 7E               7      LD  A,(HL)
       D53D                     GETSLT_3:
000FA0 D53D 07               4      RLCA
000FA1 D53E 07               4      RLCA
       D53F                     GETSLT_2:
000FA2 D53F E60C             7      AND 00CH
000FA4 D541 67               4      LD  H,A
000FA5 D542 7D               4      LD  A,L
000FA6 D543 D645             7      SUB LOW SLTTBL - 080H
000FA8 D545 B4               4      OR  H
000FA9 D546 E1              10      POP HL
000FAA D547 C9              10      RET
       D548                     GETSLT_1:               ;スロットは拡張されていない
000FAB D548 D6C1             7      SUB LOW EXPTBL
000FAD D54A E1              10      POP HL
000FAE D54B C9              10      RET
                                
       D54C                     GETSLT_40H:             ;ページ1
000FAF D54C 0F               4      RRCA
000FB0 D54D 0F               4      RRCA
000FB1 D54E E603             7      AND 3
000FB3 D550 85               4      ADD A,L
000FB4 D551 6F               4      LD  L,A
000FB5 D552 CB7E            13      BIT 7,(HL)
000FB7 D554 28F2            12      JR  Z,GETSLT_1
000FB9 D556 C604             7      ADD A,SLTTBL-EXPTBL
000FBB D558 6F               4      LD  L,A
000FBC D559 7E               7      LD  A,(HL)
000FBD D55A 18E3            12      JR  GETSLT_2
                                
       D55C                     GETSLT_HIGH:
