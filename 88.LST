00189E E997 0F               4      RRCA
00189F E998 CDC8E9          17      CALL    FATSETUP12  ;自己書き換え
       E999                     FATSX   EQU $-2
0018A2 E99B 210000          10      LD  HL,0
0018A5 E99E 4A               4      LD  C,D
0018A6 E99F 54               4      LD  D,H
0018A7 E9A0 3AABEE          13      LD  A,(_FATIX)  ;範囲FAT12:0-3/FAT16:0-127(0-07FH):65535*2/1024
0018AA E9A3 47               4      LD  B,A
0018AB E9A4 04               4      INC B
0018AC E9A5 DD7E00          19      LD  A,(IX+DPB_FATLN)
       E9A8                     FAT_SKP:
