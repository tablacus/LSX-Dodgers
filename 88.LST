0018B3 E9AC 93               4      SUB E
0018B4 E9AD 30F9            12      JR  NC,FAT_SKP
0018B6 E9AF DDCB0146        20      BIT 0,(IX+DPB_FATLN+1)  ;FATサイズが0100H(256)の場合
0018BA E9B3 C8              11      RET Z
       E9B4                     FAT1:
0018BB E9B4 EB               4      EX  DE,HL
0018BC E9B5 B7               4      OR  A       ;0の場合は0100Hとして扱う
0018BD E9B6 2803            12      JR  Z,FAT3
0018BF E9B8 B9               4      CP  C       ;C=FATバッファに読み込めるセクタ数
0018C0 E9B9 3801            12      JR  C,FAT2
       E9BB                     FAT3:
0018C2 E9BB 79               4      LD  A,C
       E9BC                     FAT2:
0018C3 E9BC 47               4      LD  B,A
                                
0018C4 E9BD 2AFAEF          16      LD  HL,(_FATPS) ;fat sector pos
0018C7 E9C0 19              11      ADD HL,DE
0018C8 E9C1 EB               4      EX  DE,HL
0018C9 E9C2 2A7CEF          16      LD  HL,(_FATBF)
