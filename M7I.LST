                                ;------------------------
                                ;FATのセットアップ
                                ;out
                                ;   B  : FATセクタ数
                                ;   DE : FAT先頭セクタ番号
                                ;   HL : FATバッファポインタ
                                ;   CF : 1=ドライブ切り替えエラー
                                ;note
                                ;   FATサイズがFATバッファを超える場合は
                                ;   対象クラスタ領域==(_FATIX)によって
                                ;   FAT12:対象クラスタ1024毎に1.5KBを切り替える
                                ;   FAT16:対象クラスタ512毎に1KBを切り替える
                                ;------------------------
       E7E2                     FATSETUP:
001AC3 E7E2 3AAAF0          13      LD  A,(_FATDRV)
001AC6 E7E5 CDEBE8          17      CALL    CHGDRVR     ;ドライブ切り替え
001AC9 E7E8 D8              11      RET C
       E7E9                     FATS2:
001ACA E7E9 DD7E0F          19      LD  A,(IX+DPB_BPS)  ;512=2 1024=4
001ACD E7EC 0F               4      RRCA
001ACE E7ED CD1DE8          17      CALL    FATSETUP12  ;自己書き換え
       E7EE                     FATSX   EQU $-2
001AD1 E7F0 210000          10      LD  HL,0
001AD4 E7F3 4A               4      LD  C,D
001AD5 E7F4 54               4      LD  D,H
001AD6 E7F5 3AABF0          13      LD  A,(_FATIX)  ;範囲FAT12:0-3/FAT16:0-127(0-07FH):65535*2/1024
001AD9 E7F8 47               4      LD  B,A
001ADA E7F9 04               4      INC B
001ADB E7FA DD7E00          19      LD  A,(IX+DPB_FATLN)
       E7FD                     FAT_SKP:
001ADE E7FD 05               4      DEC B
001ADF E7FE 2809            12      JR  Z,FAT1
001AE1 E800 19              11      ADD HL,DE
001AE2 E801 93               4      SUB E
001AE3 E802 30F9            12      JR  NC,FAT_SKP
001AE5 E804 DDCB0146        20      BIT 0,(IX+DPB_FATLN+1)  ;FATサイズが0100H(256)の場合
001AE9 E808 C8              11      RET Z
       E809                     FAT1:
001AEA E809 EB               4      EX  DE,HL
001AEB E80A B7               4      OR  A       ;0の場合は0100Hとして扱う
001AEC E80B 2803            12      JR  Z,FAT3
001AEE E80D B9               4      CP  C       ;C=FATバッファに読み込めるセクタ数
001AEF E80E 3801            12      JR  C,FAT2
       E810                     FAT3:
001AF1 E810 79               4      LD  A,C
       E811                     FAT2:
001AF2 E811 47               4      LD  B,A
                                
