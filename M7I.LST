001AF6 E815 19              11      ADD HL,DE
001AF7 E816 EB               4      EX  DE,HL
001AF8 E817 2A7CF1          16      LD  HL,(_FATBF)
001AFB E81A AF               4      XOR A       ;CF=0
001AFC E81B 4F               4      LD  C,A
001AFD E81C C9              10      RET
