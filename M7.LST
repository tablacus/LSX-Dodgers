                                #IF EXISTS USE_8253
                                ARWKEY:
                                    DEC A
                                    LD  (KEYAR),A
                                    JR  INT8253E
                                SETKEY1:
                                    LD  A,(_KEYSP_H)
                                    JR  SETKEY
                                INT8253:
                                    CALL    CHKEY
                                    CP  0
                                KEYDT   EQU $-1
                                    JR  NZ,SETKEY1
                                    PUSH    HL
                                    LD  HL,(_KEYPS)
                                    LD  A,H
                                    XOR L
                                    POP HL
                                    JR  NZ,INT8253E
                                    LD  A,0
                                KEYAR   EQU $-1
                                    OR  A
                                    JR  NZ,ARWKEY
                                SETKEY:
                                    LD  (KEYAR),A
                                    CALL    GETKEYD
                                    LD  (KEYDT),A
                                    CALL    KEYSET
                                INT8253E:
                                    LD  A,0
                                INTMEM_SWC  EQU $-1
                                    CP  0C9H        ;RAMの場合はEXTBIOにRETが入っている
                                    JP  NZ,ROM8253E
                                    POP AF
                                    EI
                                    RET
                                KEYSET:
                                KEYBS:
                                    OR  A
                                    RET Z
                                KEYBS1:
                                    CALL    KEYBC_IFBREAK
                                    PUSH    HL
                                    PUSH    AF
                                    LD  HL,(_KEYPS)
                                    INC L
                                    RES 5,L
                                    LD  A,L
                                    CP  H
                                    JR  Z,POP_AF_HL_SCF_RET
                                    LD  (_KEYPS),A
                                    LD  H,HIGH KEYBF
                                    POP AF
                                    LD  (HL),A
                                    POP HL
                                    RET
                                KEYBC_IFBREAK:
                                    CP  3
                                    RET NZ
                                KEYBC:
                                    PUSH    HL
                                    LD  HL,0
                                    LD  (_KEYPS),HL
                                    POP HL
                                    RET
                                #ENDIF
                                
