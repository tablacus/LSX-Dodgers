                                ;------------------------
                                ;FATのセットアップ
                                ;out
                                ;   B  : FATセクタ数
                                ;   DE : FAT先頭セクタ番号
                                ;   HL : FATバッファポインタ
                                ;   CF : 1=ドライブ切り替えエラー
                                ;note
                                ;   FATサイズがFATバッファを超える場合は
                                ;   対象クラスタ領域==(_FATIX)によって
                                ;   FAT12:対象クラスタ1024毎に1.5KBを切り替える
                                ;   FAT16:対象クラスタ512毎に1KBを切り替える
                                ;------------------------
       E7A2                     FATSETUP:
001A83 E7A2 3AAAF0          13      LD  A,(_FATDRV)
001A86 E7A5 CDABE8          17      CALL    CHGDRVR     ;ドライブ切り替え
001A89 E7A8 D8              11      RET C
       E7A9                     FATS2:
001A8A E7A9 DD7E0F          19      LD  A,(IX+DPB_BPS)  ;512=2 1024=4
001A8D E7AC 0F               4      RRCA
001A8E E7AD CDDDE7          17      CALL    FATSETUP12  ;自己書き換え
       E7AE                     FATSX   EQU $-2
001A91 E7B0 210000          10      LD  HL,0
001A94 E7B3 4A               4      LD  C,D
001A95 E7B4 54               4      LD  D,H
001A96 E7B5 3AABF0          13      LD  A,(_FATIX)  ;範囲FAT12:0-3/FAT16:0-127(0-07FH):65535*2/1024
001A99 E7B8 47               4      LD  B,A
001A9A E7B9 04               4      INC B
001A9B E7BA DD7E00          19      LD  A,(IX+DPB_FATLN)
       E7BD                     FAT_SKP:
001A9E E7BD 05               4      DEC B
001A9F E7BE 2809            12      JR  Z,FAT1
001AA1 E7C0 19              11      ADD HL,DE
001AA2 E7C1 93               4      SUB E
001AA3 E7C2 30F9            12      JR  NC,FAT_SKP
001AA5 E7C4 DDCB0146        20      BIT 0,(IX+DPB_FATLN+1)  ;FATサイズが0100H(256)の場合
001AA9 E7C8 C8              11      RET Z
       E7C9                     FAT1:
001AAA E7C9 EB               4      EX  DE,HL
001AAB E7CA B7               4      OR  A       ;0の場合は0100Hとして扱う
001AAC E7CB 2803            12      JR  Z,FAT3
001AAE E7CD B9               4      CP  C       ;C=FATバッファに読み込めるセクタ数
001AAF E7CE 3801            12      JR  C,FAT2
       E7D0                     FAT3:
001AB1 E7D0 79               4      LD  A,C
       E7D1                     FAT2:
001AB2 E7D1 47               4      LD  B,A
                                
001AB3 E7D2 2AFAF1          16      LD  HL,(_FATPS) ;fat sector pos
001AB6 E7D5 19              11      ADD HL,DE
001AB7 E7D6 EB               4      EX  DE,HL
001AB8 E7D7 2A7CF1          16      LD  HL,(_FATBF)
001ABB E7DA AF               4      XOR A       ;CF=0
001ABC E7DB 4F               4      LD  C,A
001ABD E7DC C9              10      RET
