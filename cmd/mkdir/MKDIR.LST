000046 0146 CD0500          17      CALL    SYSTEM
000049 0149 FEFF             7      CP  0FFH
00004B 014B CAEA01          10      JP  Z,SHOW_NOT_CREATE   ;取得できない場合はエラー
00004E 014E F5              11      PUSH    AF      ;A←1クラスタのセクタ数(1,2,4,8,16)
00004F 014F ED437401        20      LD  (SECPAT),BC ;BC←論理セクタのサイズ
                                
000053 0153 218902          10      LD  HL,DIRENT3;
000056 0156 118A02          10      LD  DE,DIRENT3+1;
000059 0159 0B               6      DEC BC
00005A 015A EDB0                    LDIR            ;0クリア
                                
00005C 015C 210000          10      LD  HL,0
00005F 015F 227F00          16      LD  (FCB1+35),HL    ;ランダム・レコード
000062 0162 227D00          16      LD  (FCB1+33),HL    ;ランダム・レコード
000065 0165 24               4      INC H
000066 0166 226A00          16      LD  (FCB1+14),HL    ;レコード・サイズ
000069 0169 C1              10      POP BC      ;クラスタのセクタ数(1,2,4,8,16)
                                
00006A 016A 114902          10      LD  DE,SUBD
       016D                     LOOP1:
00006D 016D C5              11      PUSH    BC
00006E 016E 0E1A             7      LD  C,01AH      ;SETDTA ディスク転送アドレスの設定 CP/M
000070 0170 CD0500          17      CALL    SYSTEM
000073 0173 210002          10      LD  HL,512      ;論理セクタのサイズ
       0174                     SECPAT  EQU $-2
000076 0176 115C00          10      LD  DE,FCB1
000079 0179 0E26             7      LD  C,026H      ;WRBLK FCB ランダムブロック書き込み
00007B 017B CD0500          17      CALL    SYSTEM
00007E 017E C1              10      POP BC
00007F 017F B7               4      OR  A
000080 0180 2068            12      JR  NZ,SHOW_NOT_CREATE
000082 0182 118902          10      LD  DE,DIRENT3
000085 0185 10E6            13      DJNZ    LOOP1
                                
000087 0187 2A7600          16      LD  HL,(FCB1+26)    ;ファイルの先頭クラスタ
00008A 018A 226302          16      LD  (SELFCL),HL
                                
00008D 018D 210000          10      LD  HL,0
000090 0190 227F00          16      LD  (FCB1+35),HL    ;ランダム・レコード
000093 0193 211A00          10      LD  HL,SELFCL-SUBD
000096 0196 227D00          16      LD  (FCB1+33),HL    ;ランダム・レコード
                                
000099 0199 116302          10      LD  DE,SELFCL   ;DTA = SELFCL のアドレス
00009C 019C 0E1A             7      LD  C,01AH      ;SETDTA ディスク転送アドレスの設定 CP/M
00009E 019E CD0500          17      CALL    SYSTEM
                                
0000A1 01A1 115C00          10      LD  DE,FCB1
0000A4 01A4 210200          10      LD  HL,2
0000A7 01A7 0E26             7      LD  C,026H      ;WRBLK FCB ランダムブロック書き込み
0000A9 01A9 CD0500          17      CALL    SYSTEM
0000AC 01AC B7               4      OR  A
0000AD 01AD 203B            12      JR  NZ,SHOW_NOT_CREATE
                                
0000AF 01AF 3E10             7      LD  A,010H      ;ディレクトリ
0000B1 01B1 326900          13      LD  (FCB1+13),A ;属性(アトリビュート)
0000B4 01B4 210000          10      LD  HL,0
0000B7 01B7 226C00          16      LD  (FCB1+16),HL    ;ファイルのサイズ
                                
0000BA 01BA 115C00          10      LD  DE,FCB1
0000BD 01BD 0E10             7      LD  C,010H      ;FCLOSE FCB ファイルクローズ CP/M
0000BF 01BF CD0500          17      CALL    SYSTEM
       01C2                     SUCCESS:
0000C2 01C2 112002          10      LD  DE,OKMES
0000C5 01C5 180B            12      JR  EXITMES
                                
