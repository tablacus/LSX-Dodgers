000014 0114 CD0500          17      CALL    SYSTEM
000017 0117 B7               4      OR  A
000018 0118 CAEF01          10      JP  Z,SHOW_EXISTS   ;すでに存在する場合はエラー
                                
00001B 011B 115C00          10      LD  DE,FCB1
00001E 011E 3A5D00          13      LD  A,(FCB1+1)
000021 0121 FE20             7      CP  020H
000023 0123 CAC701          10      JP  Z,SHOW_TITLE
                                
000026 0126 0E16             7      LD  C,016H      ;FMAKE FCB ファイル作成 CP/M
000028 0128 CD0500          17      CALL    SYSTEM
00002B 012B B7               4      OR  A
00002C 012C C2EA01          10      JP  NZ,SHOW_NOT_CREATE  ;作成に失敗する場合はエラー
                                
00002F 012F 3A7900          13      LD  A,(FCB1+29) ;ディレクトリ・モード
000032 0132 B7               4      OR  A
000033 0133 280B            12      JR  Z,ROOT
                                
000035 0135 2A6A00          16      LD  HL,(FCB1+14)    ;アクセスするディレクトリのクラスタ番号+1
000038 0138 7C               4      LD  A,H
000039 0139 B5               4      OR  L
00003A 013A 2804            12      JR  Z,ROOT
00003C 013C 2B               6      DEC HL
00003D 013D 228302          16      LD  (PARENTCL),HL
       0140                     ROOT:
000040 0140 215C00          10      LD  HL,FCB1
