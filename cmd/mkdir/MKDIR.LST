0000CA 01CA 0E09             7      LD  C,9     ;STROUT 文字列出力 CP/M
0000CC 01CC CD0500          17      CALL    SYSTEM
0000CF 01CF 110702          10      LD  DE,ERRMES1
       01D2                     EXITMES:
0000D2 01D2 0E09             7      LD  C,9     ;STROUT 文字列出力 CP/M
0000D4 01D4 CD0500          17      CALL    SYSTEM
0000D7 01D7 C30000          10      JP  0
       01DA                     SHOW_MESSAGE:
